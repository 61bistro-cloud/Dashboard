# Pooled connection — for runtime queries (Prisma client at runtime)
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Direct connection — for migrations (prisma migrate deploy)
# pgbouncer pool doesn't support advisory locks needed by Prisma migration
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Vercel Preview only: use a SEPARATE Neon branch/database with no production data.
# DATABASE_ENVIRONMENT="preview"
# PREVIEW_DATABASE_HOST="your-preview-branch-pooler.region.aws.neon.tech"
# PRODUCTION_DATABASE_HOST="your-production-branch-pooler.region.aws.neon.tech"
# Never set VERCEL_ENV manually on a developer machine to bypass write protection.
